<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Pachacutec: v135 - Migración Extension XML Cierre de Caja Odoo 18 -->
    <t t-name="ClosePosPopupPatch" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        
        <!-- Total Orders in USD -->
        <xpath expr="//div[hasclass('total-orders')]" position="inside">
            <div class="currency-ref-total" style="color: #6c757d; font-size: 0.9em;">
                (<t t-esc="pos.getAmountInRefCurrency(props.orders_details.amount, true)"/>)
            </div>
        </xpath>

        <!-- Cash Overview headers / body modifications -->
        <!-- Injecting USD counted cash row -->
        <xpath expr="//div[hasclass('payment-methods-overview')]" position="before">
            <t t-if="pos.config.cash_control and props.default_cash_details and props.default_cash_details.default_cash_details_ref and state.payments_usd[props.default_cash_details.default_cash_details_ref.id]">
                <div class="cash-overview-usd-container mb-3" style="border: 1px solid #dee2e6; border-radius: 4px; padding: 10px;">
                    <h4 style="color: #008784; border-bottom: 1px solid #eee; padding-bottom: 5px;">Resumen USD</h4>
                    <div class="cash-row-usd d-flex justify-content-between align-items-center">
                        <div><t t-esc="props.default_cash_details.default_cash_details_ref.name"/></div>
                        <div class="text-end font-weight-bold">
                            Total Sistema: <span style="color: #008784;" t-esc="pos.format_currency_ref(props.default_cash_details.default_cash_details_ref.amount)"/>
                        </div>
                    </div>
                    <div class="input-group mt-2">
                        <span class="input-group-text">Contado USD</span>
                        <input class="form-control" type="number" step="0.01"
                               t-model.number="state.payments_usd[props.default_cash_details.default_cash_details_ref.id].counted"
                               t-on-input="() => this.handleInputChangeUSD(props.default_cash_details.default_cash_details_ref.id)"/>
                        <button class="btn btn-outline-secondary" t-on-click="openDetailsPopupUSD">
                            <i class="fa fa-calculator" role="img" title="Calculadora USD"/>
                        </button>
                    </div>
                    <div class="mt-2 text-end" t-att-class="{'text-danger': state.payments_usd[props.default_cash_details.default_cash_details_ref.id].difference}">
                        Diferencia: <t t-esc="pos.format_currency_ref(state.payments_usd[props.default_cash_details.default_cash_details_ref.id].difference)"/>
                    </div>
                </div>
            </t>
        </xpath>

        <!-- Money Details Popup Instance (v18 compatible component) -->
        <xpath expr="//div[hasclass('payment-methods-overview')]" position="after">
            <MoneyDetailsPopupUSD
                t-if="state.displayMoneyDetailsPopupUSD"
                manualInputCashCountUSD="manualInputCashCountUSD"
                onConfirm.bind="updateCountedCashUSD"
                onDiscard.bind="closeDetailsPopupUSD"
            />
        </xpath>
        
        <!-- Multi-currency columns in payment methods (Stuctural XPath: added after amount span) -->
        <xpath expr="//div[hasclass('payment-methods-overview')]//div[@t-foreach='props.non_cash_payment_methods']//div[hasclass('fs-3')]/span[2]" position="after">
            <span class="usd-amount ms-2 text-muted" style="font-size: 0.8em;">
                (<t t-esc="pos.getAmountInRefCurrency(pm.amount, true)"/>)
            </span>
        </xpath>
    </t>
</templates>
