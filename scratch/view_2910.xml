<data inherit_id="point_of_sale.pos_session_sales_details">
        <!-- 1. Categorías de productos en ventas -->
        <xpath expr="//tr[@t-foreach='products']/td[4]" position="inside">
            / <span style="color: red"><t t-esc="category['total_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>

        <!-- 2. Líneas de productos en ventas -->
        <xpath expr="//tr[@t-foreach=&quot;category['products']&quot;]/td[4]" position="inside">
            / <span style="color: red"><t t-esc="line['base_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>

        <!-- 3. Total general de ventas de productos -->
        <xpath expr="//div[@id='sales']//tr[td/strong[text()='Total']]/td[4]" position="inside">
            / <span style="color: red"><strong><t t-esc="products_info['total_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></strong></span>
        </xpath>

        <!-- 4. Impuestos en Ventas -->
        <xpath expr="//div[@id='taxe_sales']//tr[@t-foreach='taxes']/td[2]" position="inside">
            / <span style="color: red"><t t-esc="tax['tax_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <xpath expr="//div[@id='taxe_sales']//tr[@t-foreach='taxes']/td[3]" position="inside">
            / <span style="color: red"><t t-esc="tax['base_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Fila Total de impuestos -->
        <xpath expr="//div[@id='taxe_sales']//tr[td/strong[text()='Total']]/td[2]" position="inside">
            / <span style="color: red"><strong><t t-esc="taxes_info['tax_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></strong></span>
        </xpath>
        <xpath expr="//div[@id='taxe_sales']//tr[td/strong[text()='Total']]/td[3]" position="inside">
            / <span style="color: red"><strong><t t-esc="taxes_info['base_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></strong></span>
        </xpath>

        <!-- 5. Categorías de productos en devoluciones -->
        <xpath expr="//tr[@t-foreach='refund_products']/td[5]" position="inside">
            / <span style="color: red"><t t-esc="category['total_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Líneas de productos en devoluciones -->
        <xpath expr="//div[@id='refunds']//tr[@t-foreach=&quot;category['products']&quot;]/td[3]" position="inside">
            / <span style="color: red"><t t-esc="line['base_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Total general de devoluciones -->
        <xpath expr="//div[@id='refunds']//tr[td/strong[text()='Total']]/td[5]" position="inside">
            / <span style="color: red"><strong><t t-esc="refund_info['total_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></strong></span>
        </xpath>

        <!-- 6. Impuestos en Devoluciones -->
        <xpath expr="//div[@id='taxe_refunds']//tr[@t-foreach='refund_taxes']/td[2]" position="inside">
            / <span style="color: red"><t t-esc="tax['tax_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <xpath expr="//div[@id='taxe_refunds']//tr[@t-foreach='refund_taxes']/td[3]" position="inside">
            / <span style="color: red"><t t-esc="tax['base_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Fila Total de impuestos en devoluciones -->
        <xpath expr="//div[@id='taxe_refunds']//tr[td/strong[text()='Total']]/td[2]" position="inside">
            / <span style="color: red"><strong><t t-esc="refund_taxes_info['tax_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></strong></span>
        </xpath>
        <xpath expr="//div[@id='taxe_refunds']//tr[td/strong[text()='Total']]/td[3]" position="inside">
            / <span style="color: red"><strong><t t-esc="refund_taxes_info['base_amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></strong></span>
        </xpath>

        <!-- 7. Pagos -->
        <xpath expr="//div[@id='payments']//tr[@t-foreach='payments']/td[2]" position="inside">
            / <span style="color: red"><t t-esc="payment['total_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Fila Total de pagos -->
        <xpath expr="//div[@id='payments']//tr[th[text()='Total']]/th[2]" position="inside">
            / <span style="color: red"><t t-esc="total_paid_ref" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Métodos de pago por sesión -->
        <xpath expr="//div[@id='payments']//tr[@t-foreach='payments_per_method']/td[2]" position="inside">
            / <span style="color: red"><t t-esc="ppm['total_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>

        <!-- 8. Descuentos -->
        <xpath expr="//div[@id='discounts']/div[2]/div" position="inside">
            / <span style="color: red"><t t-esc="discount_amount_ref" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>

        <!-- 9. Facturas -->
        <xpath expr="//div[@id='invoices']//tr[@t-foreach='invoiceSession[&quot;invoices&quot;]']/td[3]" position="inside">
            / <span style="color: red"><t t-esc="invoice['total_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Fila Total de facturas -->
        <xpath expr="//div[@id='invoices']//tr[td/strong[text()='Total']]/td[3]" position="inside">
            / <span style="color: red"><strong><t t-esc="invoiceTotal_ref" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></strong></span>
        </xpath>

        <!-- 10. Control de Sesión (Session Control) -->
        <xpath expr="//t[@id='closing_session']/div/strong[contains(text(), 'Total:')]" position="inside">
            / <span style="color: red"><t t-esc="total_paid_ref" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Expected, Counted, Difference en Control de Sesión -->
        <xpath expr="//t[@id='closing_session']//t[@t-foreach='payments']//tr[1]/td[3]" position="inside">
            / <span style="color: red"><t t-esc="method['final_count_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <xpath expr="//t[@id='closing_session']//t[@t-foreach='payments']//tr[1]/td[4]" position="inside">
            / <span style="color: red"><t t-esc="method['money_counted_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <xpath expr="//t[@id='closing_session']//t[@t-foreach='payments']//tr[1]/td[5]" position="inside">
            / <span style="color: red"><t t-esc="method['money_difference_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>
        <!-- Movimientos de efectivo (cash_moves) -->
        <xpath expr="//t[@id='closing_session']//tr[@t-foreach=&quot;method['cash_moves']&quot;]/td[3]" position="inside">
            / <span style="color: red"><t t-esc="move['amount_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/></span>
        </xpath>

        <!-- Desglose de IGTF en Reporte Z -->
        <xpath expr="//div[@id='taxe_sales']" position="after">
            <t t-if="igtf_totals and igtf_totals['total_igtf_bs'] &gt; 0">
                <div style="margin-top: 15px; margin-bottom: 15px; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px; background-color: #fafafa;">
                    <h5 style="color: #a04000; border-bottom: 1px solid #dee2e6; padding-bottom: 5px; margin-bottom: 10px; font-weight: bold; font-size: 1.1em;">
                        Impuesto IGTF Recaudado (3%)
                    </h5>
                    <table class="table table-sm" style="margin-bottom: 0;">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th class="text-end">Monto Bs</th>
                                <th class="text-end">Monto USD ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Base Imponible Divisa</td>
                                <td class="text-end">
                                    <t t-esc="igtf_totals['total_igtf_base_bs']" t-options="{'widget': 'float', 'precision': 2}"/> <t t-esc="symbol"/>
                                </td>
                                <td class="text-end" style="color: #008784;">
                                    <t t-esc="igtf_totals['total_igtf_base_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/>
                                </td>
                            </tr>
                            <tr style="font-weight: bold; color: #a04000;">
                                <td>Impuesto IGTF (3%)</td>
                                <td class="text-end">
                                    <t t-esc="igtf_totals['total_igtf_bs']" t-options="{'widget': 'float', 'precision': 2}"/> <t t-esc="symbol"/>
                                </td>
                                <td class="text-end" style="color: #008784;">
                                    <t t-esc="igtf_totals['total_igtf_ref']" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/> <t t-esc="symbol_ref"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </data>