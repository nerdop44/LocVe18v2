<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_igtf_tax.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-total-due')]" position="before">
            <div t-if="currentOrder.x_igtf_amount > 0" class="payment-status-igtf" style="font-size: 0.9em; color: #7c7bad; border-bottom: 1px dashed #ccc; padding-bottom: 5px; margin-bottom: 5px;">
                <div class="d-flex justify-content-between">
                    <span>Subtotal Venta:</span>
                    <span><t t-esc="props.formatCurrency(currentOrder.get_total_with_tax() - currentOrder.x_igtf_amount)"/></span>
                </div>
                <div class="d-flex justify-content-between font-weight-bold" style="color: #6c757d;">
                    <span>IGTF (3%):</span>
                    <span>+ <t t-esc="props.formatCurrency(currentOrder.x_igtf_amount)"/></span>
                </div>
            </div>
        </xpath>
    </t>
</templates>
